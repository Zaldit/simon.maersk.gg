---
/**
 * /playing — one printed chart insert per genre, stacked (frame 1g).
 * Adding a genre = adding one record file of type "playing".
 * The speed scale is fixed at 118–154 bpm on every sheet so they compare honestly.
 * Tabs: src/scripts/playing.ts. Without JS the tabs are anchors and :target
 * picks the sheet. State: playing.genreIndex.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Grain from '../components/Grain.astro';
import PlayingChart from '../components/svg/PlayingChart.astro';
import { genreSlug, getRecords } from '../lib/records';

const { playing } = await getRecords();
const genres = playing.map((g) => {
  const tracks = g.data.tracks;
  const bpms = tracks.map((t) => t.bpm);
  const min = Math.min(...bpms);
  const max = Math.max(...bpms);
  const peak = tracks.reduce((b, t, i) => (t.energy > tracks[b]!.energy ? i : b), 0);
  return {
    id: genreSlug(g.id),
    name: g.data.title,
    description: g.data.description,
    tracks,
    range: `${min}–${max}`,
    summary: `${g.data.title}: speed and energy of ${tracks.length} tracks, from ${min} to ${max} beats per minute. The most intense is track ${String(peak + 1).padStart(2, '0')}.`,
  };
});
---

<Base title="What I'm playing" description="What's in my bag right now, sorted by genre.">
  <div class="page">
    <Header links={[{ href: '/', label: '← Crate' }, { href: '/index/', label: 'Index' }]} />
    <main id="main" class="playing" data-playing>
      <div class="intro">
        <p class="kicker"><span class="kicker__dot" aria-hidden="true"></span>What I'm playing</p>
        <h1 class="title">What's in my bag right now.</h1>
        <p class="lede">Sorted by genre. Pick one on the tabs to see what's in it.</p>
        <p class="lede">The line shows how fast each track is; the bars show how intense it feels.</p>
      </div>

      <div class="stack">
        <nav class="tabs" aria-label="Genres" data-tablist>
          {
            genres.map((g, i) => (
              <a class:list={['tab', i === 0 && 'is-active']} href={`#${g.id}`} data-tab={g.id}>
                <span class="tab__n">
                  {g.tracks.length}
                  <span class="visually-hidden"> tracks,</span>
                </span>
                {g.name}
              </a>
            ))
          }
        </nav>
        <div class="decoy decoy--1" aria-hidden="true"></div>
        <div class="decoy decoy--2" aria-hidden="true"></div>

        <div class="sheets">
          {
            genres.map((g) => (
              <section class="sheet" id={g.id} data-sheet={g.id} aria-labelledby={`${g.id}-name`}>
                <header class="band on-dark">
                  <div class="band__text">
                    <h2 class="band__name" id={`${g.id}-name`}>
                      {g.name}
                    </h2>
                    <p class="band__desc">{g.description}</p>
                  </div>
                  <p class="band__stats">
                    {g.tracks.length} tracks · {g.range} bpm
                  </p>
                  <Grain tone="dark" />
                </header>
                <ul class="legend plain-list" role="list" aria-hidden="true">
                  <li>
                    <span class="legend__line" />
                    Speed (beats per minute)
                  </li>
                  <li>
                    <span class="legend__bar" />
                    Energy, 1–10
                  </li>
                  <li>
                    <span class="legend__ring" />
                    Most intense
                  </li>
                </ul>
                <div class="chart">
                  <PlayingChart tracks={g.tracks.map((t) => ({ bpm: t.bpm, energy: t.energy }))} summary={g.summary} />
                </div>
                <ol class="tracklist plain-list" role="list">
                  {g.tracks.map((t, i) => (
                    <li>
                      <span class="tracklist__n">{String(i + 1).padStart(2, '0')}</span>
                      <span class="tracklist__who">
                        {t.artist} – {t.title}
                      </span>
                      <span class="tracklist__stats">
                        {t.bpm}
                        <span class="visually-hidden"> bpm, energy</span> · {t.energy}/10
                      </span>
                    </li>
                  ))}
                </ol>
                <Grain tone="light" />
              </section>
            ))
          }
        </div>
      </div>
    </main>
  </div>
</Base>

<script>
  import '../scripts/playing.ts';
</script>

<style>
  .page {
    position: relative;
    max-width: var(--frame);
    margin-inline: auto;
  }
  .playing {
    display: grid;
    grid-template-columns: 300px minmax(0, 960px);
    column-gap: 64px;
    align-items: start;
    padding: 132px var(--gutter) 40px;
    min-height: max(100svh, 900px);
  }

  .intro {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    font: 12px var(--f-mono);
  }
  .kicker__dot {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: inset 0 0 0 3px var(--accent);
  }
  .title {
    font: 750 44px/1 var(--f-display);
    font-stretch: 76%;
  }
  .lede {
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted);
  }

  /* The stack: two decoy sheets behind the active insert, tabs on top. */
  .stack {
    position: relative;
    display: grid;
    padding-top: 48px;
  }
  .decoy,
  .sheets {
    grid-area: 1 / 1;
  }
  .decoy {
    box-shadow: 2px 4px 10px rgba(0, 0, 0, 0.14);
  }
  .decoy--1 {
    margin: 6px -16px 4px 16px;
    background: var(--decoy-1);
    transform: rotate(1.2deg);
  }
  .decoy--2 {
    margin: 0 -8px 10px 8px;
    background: var(--decoy-2);
    transform: rotate(-0.2deg);
  }
  .sheets {
    position: relative;
    display: grid;
  }
  .sheet {
    grid-area: 1 / 1;
    position: relative;
    min-height: 690px;
    display: flex;
    flex-direction: column;
    background: var(--insert-paper);
    box-shadow: 3px 8px 22px rgba(0, 0, 0, 0.22);
    transform: rotate(-1deg);
    scroll-margin-top: 40px;
  }
  /* Without JS: the first sheet, or the one the URL points at. */
  .playing:not(.js-tabs) .sheet:not(:first-child),
  .playing:not(.js-tabs) .sheets:has(.sheet:target) .sheet {
    display: none;
  }
  .playing:not(.js-tabs) .sheets:has(.sheet:target) .sheet:target {
    display: flex;
  }
  /* With JS: playing.ts sets [hidden]. */
  .sheet[hidden] {
    display: none;
  }
  .sheet.is-entering {
    animation: sheet-up 300ms var(--ease-lift);
  }
  @keyframes sheet-up {
    from {
      transform: translateY(36px) rotate(-1deg);
    }
    to {
      transform: rotate(-1deg);
    }
  }

  .tabs {
    position: absolute;
    z-index: 2;
    left: 24px;
    top: 0;
    display: flex;
    align-items: flex-start;
    gap: 6px;
    transform: rotate(-1deg);
    transform-origin: bottom left;
  }
  .tab {
    height: 40px;
    margin-top: 8px;
    padding: 0 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--card);
    border-radius: var(--r-tab);
    font: 700 16px var(--f-display);
    font-stretch: 80%;
    white-space: nowrap;
    transition: transform 180ms var(--ease-lift);
  }
  .tab:hover {
    text-decoration: none;
    transform: translateY(-4px);
  }
  /* The inactive tab is 40px tall by design; its hit area reaches 48px. */
  .tab {
    position: relative;
  }
  .tab::before {
    content: '';
    position: absolute;
    inset: -8px 0 0;
  }
  .tab__n {
    font: 500 11px var(--f-mono);
    color: var(--muted);
  }
  .tab.is-active {
    height: 48px;
    margin-top: 0;
    padding: 0 16px;
    background: var(--ink);
    color: var(--paper);
    font-size: 17px;
  }
  .tab.is-active:hover {
    transform: none;
  }
  .tab.is-active .tab__n {
    color: inherit;
    opacity: 0.7;
  }
  .tab.is-active:focus-visible {
    outline-color: var(--ink);
  }

  .band {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    padding: 22px 32px;
    background: var(--ink);
    color: var(--paper);
  }
  .band__text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .band__name {
    font: 850 40px/1 var(--f-display);
    font-stretch: 72%;
  }
  .band__desc {
    font-size: 15px;
    line-height: 1.3;
    color: var(--on-dark-soft);
  }
  .band__stats {
    font: 12px var(--f-mono);
    white-space: nowrap;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin: 0;
    padding: 18px 32px 0;
    font: 12px var(--f-mono);
    color: var(--muted);
    white-space: nowrap;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .legend__line {
    width: 22px;
    height: 3px;
    background: var(--ink);
  }
  .legend__bar {
    width: 12px;
    height: 12px;
    background: var(--energy);
  }
  .legend__ring {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--accent);
  }
  .chart {
    height: 270px;
    padding: 6px 20px 0;
  }

  .tracklist {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 40px;
    margin: 0;
    padding: 6px 32px 22px;
    font: 13px/1.3 var(--f-mono);
  }
  .tracklist li {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    gap: 8px;
    padding: 8px 0;
    border-bottom: 1px solid rgba(19, 17, 16, 0.12);
  }
  .tracklist__n {
    color: var(--faint);
  }
  .tracklist__who {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tracklist__stats {
    color: var(--muted);
    white-space: nowrap;
  }

  @media (max-width: 1199px) {
    .playing {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
      padding-top: 110px;
      min-height: 0;
    }
    .intro {
      max-width: 560px;
    }
  }
  @media (max-width: 767px) {
    .stack {
      padding-top: 0;
    }
    .tabs {
      position: static;
      transform: none;
      overflow-x: auto;
      margin: 0 calc(-1 * var(--gutter));
      padding: 0 var(--gutter);
      scrollbar-width: none;
    }
    .tab {
      height: 44px;
      margin-top: 4px;
    }
    .tab.is-active {
      margin-top: 0;
    }
    .stack {
      display: flex;
      flex-direction: column;
    }
    .decoy {
      display: none;
    }
    .sheet {
      min-height: 0;
      transform: none;
    }
    .sheet.is-entering {
      animation-name: sheet-up-flat;
    }
    @keyframes sheet-up-flat {
      from {
        transform: translateY(24px);
      }
    }
    .band {
      flex-direction: column;
      gap: 10px;
      padding: 20px;
    }
    .legend {
      padding: 16px 20px 0;
    }
    .chart {
      height: auto;
      aspect-ratio: 860 / 270;
      padding: 6px 8px 0;
    }
    .tracklist {
      grid-template-columns: minmax(0, 1fr);
      padding: 6px 20px 20px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tab {
      transition: none;
    }
    .sheet.is-entering {
      animation: none;
    }
  }
</style>
