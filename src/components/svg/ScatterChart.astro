---
/**
 * Experiment key × tempo chart (viewBox 0 0 760 410), drawn as a halftone
 * grid: tracks are counted per 5 bpm column (115–165, centred on each tick) and
 * per Camelot key number, labelled 1A/B–12A/B (major keys share the row of
 * their relative minor). Each cell with tracks gets
 * one ink dot whose area is its count, the fullest cell at r 12. An accent box
 * marks the cluster. Tracks outside the speed range are left off.
 *
 * Dots drop in once on first view, left to right (all within ~2s), and show
 * their count on hover (src/scripts/scatter.ts). Without JS or with reduced
 * motion the chart is simply complete.
 */
import { camelotIndex } from '../../lib/music';

export interface ScatterPoint {
  bpm: number;
  /** Camelot minor key, 1A–12A. */
  key: string;
  artist?: string;
  title?: string;
}
export interface ScatterHighlight {
  bpm: [number, number];
  /** Camelot keys, low to high, e.g. ['7A', '10A']. */
  keys: [string, string];
  label: string;
}

interface Props {
  points: ScatterPoint[];
  highlight?: ScatterHighlight;
  /** Accessible summary of what the chart shows. */
  summary: string;
  class?: string;
}

const { points, highlight, summary, class: className } = Astro.props;

const keyIndex = camelotIndex;
/** Row labels: '1A/B' … '12A/B'. */
const KEY_NAMES = Array.from({ length: 12 }, (_, i) => `${i + 1}A/B`);

const BPM_MIN = 115;
const BPM_MAX = 165;
const BIN = 5;
const ex = (t: number) => 110 + ((t - BPM_MIN) / (BPM_MAX - BPM_MIN)) * 630;
const ey = (k: number) => 350 - k * 26;
const r2 = (v: number) => Math.round(v * 100) / 100;
/** 137.5–142.4 → 140 */
const bin = (bpm: number) => Math.round(bpm / BIN) * BIN;

const ticks: number[] = [];
for (let t = BPM_MIN; t <= BPM_MAX; t += BIN) ticks.push(t);

const counts = new Map<string, { bpm: number; k: number; n: number; who?: string }>();
for (const p of points) {
  const bpm = bin(p.bpm);
  if (bpm < BPM_MIN || bpm > BPM_MAX) continue;
  const k = keyIndex(p.key);
  const id = `${bpm}/${k}`;
  const cell = counts.get(id) ?? { bpm, k, n: 0 };
  cell.n += 1;
  cell.who = cell.n === 1 ? [p.artist, p.title].filter(Boolean).join(' – ') : undefined;
  counts.set(id, cell);
}
const cells = [...counts.values()].sort((a, b) => a.bpm - b.bpm || a.k - b.k);
const most = Math.max(1, ...cells.map((c) => c.n));

/** Drop-in delay between dots, ms: 35, shortened so the whole drop takes ~2s. */
const step = r2(Math.min(35, 2000 / Math.max(cells.length, 1)));

const dots = cells.map((c, i) => ({
  cx: r2(ex(c.bpm)),
  cy: ey(c.k),
  r: r2(12 * Math.sqrt(c.n / most)),
  i,
  tip: [c.who || `${c.n} ${c.n === 1 ? 'track' : 'tracks'}`, `${c.bpm} bpm`, KEY_NAMES[c.k]].join(' · '),
}));

const hl = highlight && {
  x: r2(ex(bin(highlight.bpm[0])) - 22),
  y: ey(keyIndex(highlight.keys[1])) - 18,
  w: r2(ex(bin(highlight.bpm[1])) - ex(bin(highlight.bpm[0])) + 44),
  h: ey(keyIndex(highlight.keys[0])) - ey(keyIndex(highlight.keys[1])) + 36,
  label: highlight.label,
};
---

<figure class:list={['scatter', className]} data-scatter data-step={step} style={`--step:${step}ms;--dots:${dots.length}`}>
  <svg viewBox="0 0 760 410" preserveAspectRatio="xMinYMid meet" role="img" aria-label={summary}>
    <g class="scatter__grid" aria-hidden="true">
      {
        ticks.map((t) => (
          <>
            <line x1={r2(ex(t))} x2={r2(ex(t))} y1="50" y2="360" stroke="rgba(19,17,16,.12)" />
            <text x={r2(ex(t))} y="380" text-anchor="middle" font-size="11" fill="#4a4640" class="ff-mono">
              {t}
            </text>
          </>
        ))
      }
      {
        KEY_NAMES.map((name, i) => (
          <>
            <line x1="110" x2="740" y1={ey(i)} y2={ey(i)} stroke="rgba(19,17,16,.06)" />
            <text x="100" y={ey(i) + 4} text-anchor="end" font-size="10.5" fill="#4a4640" class="ff-mono">
              {name}
            </text>
          </>
        ))
      }
    </g>
    <g class="scatter__dots">
      {
        dots.map((d) => (
          <circle cx={d.cx} cy={d.cy} r={d.r} fill="#131211" style={`--i:${d.i}`} data-tip={d.tip}>
            <title>{d.tip}</title>
          </circle>
        ))
      }
    </g>
    {
      hl && (
        <g class="scatter__hl" aria-hidden="true">
          <rect x={hl.x} y={hl.y} width={hl.w} height={hl.h} rx="10" pathLength="1" fill="none" stroke-width="2.5" style="stroke:var(--accent)" />
          <text x={r2(hl.x + hl.w + 8)} y={hl.y + 10} font-size="11.5" fill="#131211" class="ff-mono">
            {hl.label}
          </text>
        </g>
      )
    }
    <g aria-hidden="true" font-size="11.5" fill="#131211" class="ff-mono">
      <text x="740" y="404" text-anchor="end" xml:space="preserve">Speed, beats per minute →   slower · faster</text>
      <text x="0" y="26">Musical key (Camelot)</text>
    </g>
  </svg>
  <div class="scatter__tip mono" role="status" aria-live="polite" hidden></div>
</figure>

<style>
  .scatter {
    position: relative;
    height: 100%;
    margin: 0;
  }
  .scatter svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .scatter__dots circle {
    transition: fill 120ms;
  }
  .scatter__dots circle:hover,
  .scatter__dots circle.is-active {
    fill: var(--accent);
  }
  :global(.scatter.will-drop) .scatter__dots circle,
  :global(.scatter.will-drop) .scatter__hl text {
    opacity: 0;
  }
  :global(.scatter.will-drop) .scatter__hl rect {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  /* The box draws on once the last dot has landed, then its label fades in. */
  :global(.scatter.is-dropping) .scatter__hl rect {
    animation: scatter-draw 600ms var(--ease-lift) both;
    animation-delay: calc(var(--dots) * var(--step, 35ms) + 420ms);
  }
  :global(.scatter.is-dropping) .scatter__hl text {
    animation: scatter-fade 250ms ease-out both;
    animation-delay: calc(var(--dots) * var(--step, 35ms) + 900ms);
  }
  @keyframes scatter-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes scatter-fade {
    to {
      opacity: 1;
    }
  }
  :global(.scatter.is-dropping) .scatter__dots circle {
    animation: scatter-drop 420ms var(--ease-lift) both;
    animation-delay: calc(var(--i) * var(--step, 35ms));
  }
  @keyframes scatter-drop {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .scatter__tip {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 0;
    padding: 6px 9px;
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 12px));
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.scatter.will-drop) .scatter__dots circle {
      opacity: 1;
    }
    :global(.scatter.is-dropping) .scatter__dots circle {
      animation: none;
    }
    :global(.scatter.will-drop) .scatter__hl text {
      opacity: 1;
    }
    :global(.scatter.will-drop) .scatter__hl rect {
      stroke-dashoffset: 0;
    }
    :global(.scatter.is-dropping) .scatter__hl * {
      animation: none;
    }
  }
</style>
