---
/**
 * Experiment scatter (viewBox 0 0 760 410): speed 118–150 bpm on x, the 12
 * minor keys in Camelot order on y (in plain words), r 5 ink dots at .82, and
 * an accent ellipse around the cluster.
 *
 * Dots drop in once on first view and show their track on hover
 * (src/scripts/scatter.ts). Without JS or with reduced motion the chart is
 * simply complete.
 */
import { rng } from '../../lib/series';
import { MINOR_KEYS, camelotIndex } from '../../lib/music';

export interface ScatterPoint {
  bpm: number;
  /** Camelot minor key, 1A–12A. */
  key: string;
  artist?: string;
  title?: string;
}
export interface ScatterHighlight {
  bpm: [number, number];
  /** Camelot keys, low to high, e.g. ['7A', '10A']. */
  keys: [string, string];
  label: string;
}

interface Props {
  points: ScatterPoint[];
  highlight?: ScatterHighlight;
  /** Accessible summary of what the chart shows. */
  summary: string;
  class?: string;
}

const { points, highlight, summary, class: className } = Astro.props;



const keyIndex = camelotIndex;
const KEY_NAMES = MINOR_KEYS;

const ex = (t: number) => 110 + ((t - 118) / 32) * 630;
const ey = (k: number) => 350 - k * 26;
const r2 = (v: number) => Math.round(v * 100) / 100;

const ticks = [120, 125, 130, 135, 140, 145, 150];

// Deterministic vertical jitter so dots on the same key don't sit on one line.
const jitter = rng(42);
const dots = points.map((p, i) => {
  const k = keyIndex(p.key);
  const j = (jitter() - 0.5) * 12;
  const who = [p.artist, p.title].filter(Boolean).join(' – ') || 'Track';
  return {
    cx: r2(ex(p.bpm)),
    cy: r2(ey(k) + j),
    i,
    tip: `${who} · ${Math.round(p.bpm)} bpm · ${KEY_NAMES[k]}`,
  };
});

const hl = highlight && {
  cx: r2(ex((highlight.bpm[0] + highlight.bpm[1]) / 2)),
  cy: r2((ey(keyIndex(highlight.keys[0])) + ey(keyIndex(highlight.keys[1]))) / 2),
  rx: r2((ex(highlight.bpm[1]) - ex(highlight.bpm[0])) / 2),
  ry: r2((ey(keyIndex(highlight.keys[0])) - ey(keyIndex(highlight.keys[1]))) / 2 + 20),
  lx: r2(ex(highlight.bpm[1] + 0.7)),
  ly: r2(ey(keyIndex(highlight.keys[1])) - 10),
  label: highlight.label,
};
---

<figure class:list={['scatter', className]} data-scatter>
  <svg viewBox="0 0 760 410" preserveAspectRatio="xMinYMid meet" role="img" aria-label={summary}>
    <g class="scatter__grid" aria-hidden="true">
      {
        ticks.map((t) => (
          <>
            <line x1={r2(ex(t))} x2={r2(ex(t))} y1="50" y2="360" stroke="rgba(19,17,16,.12)" />
            <text x={r2(ex(t))} y="380" text-anchor="middle" font-size="11" fill="#4a4640" class="ff-mono">
              {t}
            </text>
          </>
        ))
      }
      {
        KEY_NAMES.map((name, i) => (
          <>
            <line x1="110" x2="740" y1={ey(i)} y2={ey(i)} stroke="rgba(19,17,16,.06)" />
            <text x="100" y={ey(i) + 4} text-anchor="end" font-size="10.5" fill="#4a4640" class="ff-mono">
              {name}
            </text>
          </>
        ))
      }
    </g>
    <g class="scatter__dots">
      {
        dots.map((d) => (
          <circle cx={d.cx} cy={d.cy} r="5" fill="#131211" fill-opacity=".82" style={`--i:${d.i}`} data-tip={d.tip}>
            <title>{d.tip}</title>
          </circle>
        ))
      }
    </g>
    {
      hl && (
        <g aria-hidden="true">
          <ellipse cx={hl.cx} cy={hl.cy} rx={hl.rx} ry={hl.ry} fill="none" stroke-width="2.5" style="stroke:var(--accent)" />
          <text x={hl.lx} y={hl.ly} font-size="11.5" fill="#131211" class="ff-mono">
            {hl.label}
          </text>
        </g>
      )
    }
    <g aria-hidden="true" font-size="11.5" fill="#131211" class="ff-mono">
      <text x="740" y="404" text-anchor="end" xml:space="preserve">Speed, beats per minute →   slower · faster</text>
      <text x="0" y="26">Musical key</text>
    </g>
  </svg>
  <div class="scatter__tip mono" role="status" aria-live="polite" hidden></div>
</figure>

<style>
  .scatter {
    position: relative;
    height: 100%;
    margin: 0;
  }
  .scatter svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .scatter__dots circle {
    transition: fill-opacity 120ms;
  }
  .scatter__dots circle:hover,
  .scatter__dots circle.is-active {
    fill-opacity: 1;
  }
  :global(.scatter.will-drop) .scatter__dots circle {
    opacity: 0;
  }
  :global(.scatter.is-dropping) .scatter__dots circle {
    animation: scatter-drop 420ms var(--ease-lift) both;
    animation-delay: calc(var(--i) * 35ms);
  }
  @keyframes scatter-drop {
    from {
      opacity: 0;
      transform: translateY(-24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .scatter__tip {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 0;
    padding: 6px 9px;
    background: var(--ink);
    color: var(--paper);
    font-size: 12px;
    line-height: 1.3;
    white-space: nowrap;
    pointer-events: none;
    transform: translate(-50%, calc(-100% - 12px));
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.scatter.will-drop) .scatter__dots circle {
      opacity: 1;
    }
    :global(.scatter.is-dropping) .scatter__dots circle {
      animation: none;
    }
  }
</style>
